# Local development secrets. Copy to `.env` (gitignored).
# `astro dev` and `wrangler dev` both read `.env`.
# Do NOT keep a .dev.vars file — if present, Wrangler prefers it and ignores .env.
# In production, copy the same names with: npx wrangler secret put <NAME>
#

# HMAC key that signs this site's session cookie. Required: exactly 64 hex
# characters (32 random bytes), or every page answers 500 (@engine9/core
# 1.19+ refuses anything else). Never type one; paste the output of:
#   openssl rand -hex 32
SESSION_SECRET=""

# Admin API key for e9core upgrade --url (and other admin routes).
# Create with: npx e9core create-api-key --print-sql --name admin --scopes admin
# Then insert the SQL into D1 and paste the printed key here. Never commit .env.
# E9_ADMIN_API_KEY=
E9_SITE_URL="https://festival.engine9.ai"

# Production Delegate (default). Identity Token callbacks use ?delegate_token=.
# Optional override:
# DELEGATE_URL="http://localhost:8787"
DELEGATE_URL="https://delegate.network"
# Dev server port (default 3000; 3001 and 3002 are tried if 3000 is busy).
# Startup fails if PORT is set and that port is already in use.
# PORT=3000
