---
import { env } from "cloudflare:workers";
import { showAdmin, showVip, widgetUser } from "../lib/session";
import { BROWSER_CORE, LOGIN_FIELDS } from "../lib/engine9";
import { LOGIN_PROVIDERS, SIGN_IN_BRAND } from "../lib/brand";
import { ADMIN_SEGMENT_ID, ROLE_REGISTRY, VIP_SEGMENT_ID } from "../lib/roles";

interface Props {
  title: string;
}
const { title } = Astro.props;
const session = Astro.locals.session;
const path = Astro.url.pathname;
const isAdminRoute = path.startsWith("/admin");

/** Header login widget. Role ids are the keys `/auth/role` accepts. */
const widget = {
  delegateUrl: env.DELEGATE_URL || "https://delegate.network",
  fields: LOGIN_FIELDS,
  brand: SIGN_IN_BRAND,
  // Google and Facebook; the widget's button reads "Log in with Google or Facebook".
  loginProviders: LOGIN_PROVIDERS,
  // Sign in through core with its cookie session (see BROWSER_CORE).
  core: BROWSER_CORE,
  // Segment UUID in core's session -> the widget's role key.
  roleKeys: { [ADMIN_SEGMENT_ID]: "admin", [VIP_SEGMENT_ID]: "vip" },
  user: widgetUser(session),
  roles: [
    {
      id: "vip",
      name: ROLE_REGISTRY[VIP_SEGMENT_ID].name,
      description: "VIP Lounge and VIP-only sets",
      requiredAuth: ROLE_REGISTRY[VIP_SEGMENT_ID].requiredAuth,
    },
    {
      id: "admin",
      name: ROLE_REGISTRY[ADMIN_SEGMENT_ID].name,
      description: "Manage artists, schedule, tickets, and people",
      requiredAuth: ROLE_REGISTRY[ADMIN_SEGMENT_ID].requiredAuth,
    },
  ],
};

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/lineup", label: "Lineup" },
  { href: "/schedule", label: "Schedule" },
  { href: "/tickets", label: "Tickets" },
  { href: "/register", label: "Register" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Solstice Wave Festival</title>
    <meta name="description" content="Solstice Wave — two days of pop on the Crescent Bay waterfront. Demo site." />
  </head>
  <body class:list={{ "admin-route": isAdminRoute }}>
    <header class="site-header">
      <a class="wordmark" href="/">SOLSTICE<span>WAVE</span></a>
      <nav>
        {navLinks.map((l) => (
          <a href={l.href} class:list={{ active: path === l.href }}>{l.label}</a>
        ))}
        {showVip(session) && (
          <a href="/vip" class:list={["vip-link", { active: path.startsWith("/vip") }]}>VIP Lounge</a>
        )}
        {showAdmin(session) && (
          <a href="/admin" class:list={["admin-link", { active: path.startsWith("/admin") }]}>Admin</a>
        )}
      </nav>
      <div class="login-area">
        <span class="login-caption">Default login</span>
        <div class="session-box" data-e9-login-widget data-widget={JSON.stringify(widget)}>
          <noscript><a class="btn btn-ghost" href="/login">Log in</a></noscript>
        </div>
        <a class:list={["other-logins", { active: path === "/login" }]} href="/login">Other login options</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Solstice Wave Festival · Crescent Bay Waterfront · July 18–19, 2026</p>
      <p class="fine">
        Demo site. Sign-in is handled by <strong>delegate</strong>, engine9's
        common sign-in; access levels are this site's own
        segments.
        Log in with the <strong>Login</strong> button at the top of every page.
        <a href="/login">Other login options</a>: without popups, an emailed
        code (Level 2), and Delegate debugging.
      </p>
    </footer>
  </body>
</html>

<script>
  import { createEngine9Id } from "@engine9/id";
  import { loginWidget, type LoginWidgetUser } from "@engine9/id/widget";

  /**
   * One Delegate login widget for the whole site, and the recommended way to
   * use it on a site with a server:
   *
   *   - `core.session: "cookie"`: every sign-in starts with core's
   *     `POST /api/auth/begin` (a nonce core issued to this browser), and
   *     `id.core.login()` makes core set its HttpOnly `e9_session` cookie.
   *     That is the session the middleware gate reads. No site route
   *     exchanges the token, and page script never holds a session token.
   *   - `id.logout()` ends core's session too; `onLoggedOut` reloads after
   *     every logout request has finished.
   *
   * Role picking (`onRoleChange`, POST /auth/role) is demo-only self-serve.
   */
  const slot = document.querySelector<HTMLElement>("[data-e9-login-widget]");
  if (slot) {
    const { core, roleKeys, ...config } = JSON.parse(slot.dataset.widget || "{}");

    async function readJson(res: Response): Promise<{ message?: string; detail?: string; redirect?: string }> {
      const body = (await res.json().catch(() => ({}))) as { message?: string; detail?: string; redirect?: string };
      if (!res.ok) {
        const message = body.message || `The server answered ${res.status}.`;
        const detail = body.detail && body.detail !== message ? body.detail : "";
        throw new Error(detail ? `${message} Detail: ${detail}` : message);
      }
      return body;
    }

    const id = createEngine9Id({
      delegateUrl: config.delegateUrl,
      brand: config.brand,
      loginProviders: config.loginProviders,
      storage: "session",
      core,
    });

    const widget = loginWidget({
      ...config,
      id,
      target: slot,
      siteName: "Solstice Wave",
      async onLogin(identity): Promise<LoginWidgetUser> {
        // core verifies the token, checks the nonce it issued, and sets e9_session.
        const { session } = await id.core!.login();
        const held = (session.roles ?? []).map((roleId: string) => roleKeys[roleId]).filter(Boolean);
        // The header's VIP and Admin links are rendered on the server, by the cookie.
        if (held.length) window.location.reload();
        return {
          email: (session.email as string | undefined) ?? (identity.fields?.email as string | undefined) ?? null,
          role: held[0] ?? null,
          level: session.level ?? identity.level,
          twoFactor: identity.auth?.two_factor === true,
        };
      },
      async onRoleChange(roleId) {
        const form = new FormData();
        form.set("role", roleId);
        const res = await fetch("/auth/role", {
          method: "POST",
          headers: { accept: "application/json" },
          body: form,
        });
        window.location.assign((await readJson(res)).redirect ?? "/");
      },
      onLoggedOut() {
        window.location.assign("/");
      },
    });

    // In-page "log in" links open the same dialog. Their href (/login) is the
    // no-JavaScript fallback.
    document.addEventListener("click", (event) => {
      const opener = event.target instanceof Element ? event.target.closest("[data-open-login]") : null;
      if (!opener) return;
      event.preventDefault();
      widget.open();
    });
  }
</script>

<style is:global>
  :root {
    --bg: #0d0a1f;
    --surface: #171233;
    --surface-2: #1f1946;
    --border: #322a63;
    --text: #f1eeff;
    --muted: #a79fd1;
    --primary: #a855f7;
    --accent: #f472b6;
    --sun: #fbbf24;
    --vip: #fbbf24;
    --admin: #34d399;
    --grad: linear-gradient(120deg, #a855f7, #f472b6 55%, #fbbf24);
    --radius: 14px;
    --font: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: var(--font);
    background:
      radial-gradient(1200px 500px at 80% -10%, rgba(168, 85, 247, 0.25), transparent 60%),
      radial-gradient(900px 400px at 10% 0%, rgba(244, 114, 182, 0.18), transparent 60%),
      var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  body.admin-route {
    background: #000;
  }

  body.admin-route .site-header {
    background: rgba(0, 0, 0, 0.85);
  }

  main { flex: 1; width: min(1060px, 92vw); margin: 0 auto; padding: 2.5rem 0 4rem; }

  h1, h2, h3 { line-height: 1.15; letter-spacing: -0.02em; }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); font-weight: 800; margin: 0 0 0.5rem; }
  h2 { font-size: 1.6rem; font-weight: 750; margin: 2.5rem 0 1rem; }
  p { line-height: 1.6; }
  a { color: var(--accent); }

  .gradient-text {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1rem clamp(1rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--border);
    background: rgba(13, 10, 31, 0.8);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .wordmark {
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    color: var(--text);
    text-decoration: none;
  }
  .wordmark span {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .site-header nav { display: flex; gap: 0.25rem; flex-wrap: wrap; }
  .site-header nav a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .site-header nav a:hover { color: var(--text); background: var(--surface-2); }
  .site-header nav a.active { color: var(--text); background: var(--surface-2); }
  .site-header nav a.vip-link { color: var(--vip); }
  .site-header nav a.admin-link { color: var(--admin); }

  /* "Default login" (the widget) beside "Other login options" (/login: no popup, Level 2, debugging). */
  .login-area { margin-left: auto; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .login-caption {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* Signed in, the button shows who: the label no longer applies. */
  .login-area:has(.e9-login-widget[data-state="signed-in"]) .login-caption { display: none; }
  .session-box { display: flex; align-items: center; gap: 0.6rem; }
  .other-logins {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    padding-left: 0.6rem;
    border-left: 1px solid var(--border);
  }
  .other-logins:hover, .other-logins.active { color: var(--text); }

  /* Delegate login widget: dark festival colors, role badge like .badge below. */
  .e9-login-widget {
    --e9-accent: #a855f7;
    --e9-bg: var(--surface);
    --e9-fg: var(--text);
    --e9-muted: var(--muted);
    --e9-border: var(--border);
    --e9-surface: var(--surface-2);
    --e9-font: 15px/1.45 var(--font);
  }
  .e9-login-widget::part(button) { font-weight: 700; font-size: 0.9rem; }
  .e9-login-widget[data-role="vip"]::part(role) { background: rgba(251, 191, 36, 0.15); color: var(--vip); }
  .e9-login-widget[data-role="admin"]::part(role) { background: rgba(52, 211, 153, 0.15); color: var(--admin); }

  .badge {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
  .badge.vip { background: rgba(251, 191, 36, 0.15); color: var(--vip); border: 1px solid rgba(251, 191, 36, 0.4); }
  .badge.admin { background: rgba(52, 211, 153, 0.15); color: var(--admin); border: 1px solid rgba(52, 211, 153, 0.4); }
  .badge.member { background: rgba(168, 85, 247, 0.15); color: var(--primary); border: 1px solid rgba(168, 85, 247, 0.4); }

  .btn {
    display: inline-block;
    font: inherit;
    font-weight: 700;
    padding: 0.6rem 1.3rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    color: white;
  }
  .btn-primary { background: var(--grad); }
  .btn-primary:hover { filter: brightness(1.1); }
  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
  }
  .btn-ghost:hover { background: var(--surface-2); }
  .btn-danger { background: #be123c; font-size: 0.8rem; padding: 0.35rem 0.8rem; }
  .btn-danger:hover { filter: brightness(1.15); }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .grid { display: grid; gap: 1rem; }
  @media (min-width: 720px) {
    .grid-2 { grid-template-columns: 1fr 1fr; }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
  }

  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; }

  input, select, textarea {
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem 0.7rem;
    width: 100%;
  }
  label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--muted); margin-bottom: 0.3rem; }
  .field { margin-bottom: 0.9rem; }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem clamp(1rem, 4vw, 2.5rem);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .site-footer .fine { font-size: 0.8rem; opacity: 0.8; }
  .site-footer p { margin: 0.25rem 0; }

  .muted { color: var(--muted); }
</style>
