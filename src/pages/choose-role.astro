---
import Layout from "../layouts/Layout.astro";
import { ADMIN_SEGMENT_ID, VIP_SEGMENT_ID } from "../lib/roles";
import { canClaimRole } from "../lib/session";

// DEMO ONLY: self-serve roles, standing in for an operator granting one.
// Shown to a signed-in person who holds no role yet. Choosing writes
// person_segment (which the gate reads) and re-signs the e9_session cookie.
const session = Astro.locals.session;
if (!session) return Astro.redirect("/login");
const levelError = Astro.url.searchParams.get("error") === "level";
const canVip = canClaimRole(session, VIP_SEGMENT_ID);
const canAdmin = canClaimRole(session, ADMIN_SEGMENT_ID);
---

<Layout title="Choose your role">
  <div class="role-wrap">
    <div class="card role-card">
      <h1>Welcome!</h1>
      {session.email && <p class="welcome-email">{session.email}</p>}

      <p class="muted">
        You're signed in through <strong>delegate</strong> and recognized as
        <code>person_id {session.personId}</code>
        {session.level != null && <> at Identity Level <strong>{session.level}</strong></>}.
        Pick how you'd like to use this demo — VIP (Level 1) or Admin
        (Level 3). On a real site an operator grants roles; nobody picks their
        own. You can switch later in the Login dialog.
      </p>

      {levelError && (
        <p class="notice err">
          That role needs a higher Identity Level. VIP needs Level 1; Admin
          needs Level 3 (trusted provider).
        </p>
      )}

      <div class="buttons">
        <form method="post" action="/auth/role">
          <input type="hidden" name="role" value="vip" />
          <button class="btn btn-primary" type="submit" disabled={!canVip}>Join as VIP</button>
          <p class="who">Level 1 · VIP Lounge and VIP-only sets</p>
        </form>

        <form method="post" action="/auth/role">
          <input type="hidden" name="role" value="admin" />
          <button class="btn btn-primary admin" type="submit" disabled={!canAdmin}>Join as Admin</button>
          <p class="who">Level 3 · manage artists, schedule, tickets, and people</p>
        </form>
      </div>
    </div>
  </div>
</Layout>

<style>
  .role-wrap { display: flex; justify-content: center; padding-top: 2rem; }
  .role-card { width: min(30rem, 100%); }
  .welcome-email {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .buttons { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .buttons form { margin: 0; }
  .buttons .btn { width: 100%; }
  .btn.admin { background: linear-gradient(120deg, #10b981, #34d399); }
  .who { font-size: 0.8rem; color: var(--muted); margin: 0.4rem 0 0; text-align: center; }
  .notice.err {
    background: rgba(244, 114, 182, 0.12);
    border: 1px solid rgba(244, 114, 182, 0.4);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    margin: 1rem 0 0;
  }
  button:disabled { opacity: 0.45; cursor: not-allowed; }
  code { background: var(--surface-2); padding: 0.1rem 0.35rem; border-radius: 4px; }
</style>
