---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import { domainFromUrl } from "@engine9/core/auth/delegate";
import { changeSignInUrl, signInUrl } from "@engine9/core/auth/signIn";
import { AFTER_SIGN_IN, BROWSER_CORE, LOGIN_FIELDS } from "../lib/engine9";
import { loginErrorFor } from "../lib/loginErrors";
import { primaryRole } from "../lib/session";

/** core's /api/auth/callback sends a failed sign-in back with ?login_error=<reason>. */
const loginErrorReason = Astro.url.searchParams.get("login_error");
const loginError = loginErrorFor(loginErrorReason);
const session = Astro.locals.session;

const delegateBase = env.DELEGATE_URL || "https://delegate.network";

/** Log in without JavaScript: core's redirect sign-in (state + nonce in its e9_login cookie). */
const loginUrl = signInUrl(AFTER_SIGN_IN);
/** "Change your Delegate information": the same sign-in with prompt=select. */
const changeUrl = changeSignInUrl(AFTER_SIGN_IN);
/** A failed login that came from the person's identity, not this site's configuration. */
const showChangeOnError = Boolean(loginError) && loginError?.kind !== "configuration";

const identityBridgeUrl = new URL("/identity/bridge", delegateBase);
const domain = domainFromUrl(Astro.url.origin);
if (domain) identityBridgeUrl.searchParams.set("domain", domain);
identityBridgeUrl.searchParams.set("return_to", Astro.url.origin);
identityBridgeUrl.searchParams.set("min_level", "0");

/** Inspect Delegate itself (no Site session). */
const directDelegateLoginUrl = new URL("/login", delegateBase).toString();

const whoamiUrl = new URL("/whoami", delegateBase).toString();

/** Pre-login identity probe (top-level popup → postMessage). */
const whoamiBridgeUrl = new URL("/whoami/bridge", delegateBase);
whoamiBridgeUrl.searchParams.set("origin", Astro.url.origin);
---

<Layout title="Log in">
  <div class="login-wrap" data-delegate-url={delegateBase} data-core={JSON.stringify(BROWSER_CORE)}>
    <h1>Log in</h1>
    <p class="lede">
      This site logs in with <strong>delegate</strong>, engine9's common sign-in.
      The <strong>Login</strong> button at the top of every page (option 1)
      is how a real site logs people in. Option 2 is the fallback for
      browsers without JavaScript or popups. Option 3 signs in with an
      emailed code instead of a provider such as Google, Microsoft, or
      Facebook, at Level 2. Options 4 and 5 are
      debugging tools that show what delegate knows about this browser.
    </p>

    {session && (
      <p class="notice">
        You're logged in as <strong>{primaryRole(session).toUpperCase()}</strong>.
        Wrong email address or name? Open
        <a href={changeUrl} data-open-login>Login</a> and choose
        <strong>Switch email</strong>.
      </p>
    )}

    {loginError && (
      <p class={`notice error${loginError.kind === "configuration" ? " config" : ""}`}>
        {loginError.message}
        <span class="operator-detail">
          Error code: <code>{loginErrorReason}</code>
        </span>
        {showChangeOnError && (
          <span class="change-hint">
            Signed in with the wrong account or address?
            <a href={changeUrl}>Change your Delegate information</a>.
          </span>
        )}
      </p>
    )}

      <div class="options">
        <article class="card option">
          <h2>1. The Login button</h2>
          <p class="tag">@engine9/id login widget · the default way to use Delegate</p>
          <p>
            The <strong>Login</strong> button in the header is
            <code>loginWidget()</code> from <code>@engine9/id/widget</code>.
            One dialog on this page logs in with the providers Delegate offers
            (Google, and Microsoft or Facebook where enabled), switches the email
            address this site sees, picks VIP or Admin, and logs out. It runs
            with <code>core: {"{"} session: "cookie" {"}"}</code>, the
            recommended setting: core issues the nonce
            (<code>POST /api/auth/begin</code>), Delegate signs an Identity
            Token for it, and <code>id.core.login()</code> makes core set its
            HttpOnly <code>e9_session</code> cookie. This site has no
            sign-in route of its own. The button below opens the same dialog.
          </p>
          <p class="outcome">
            <strong>You’ll see:</strong> delegate’s sign-in if you are not
            signed in there, in this site’s colors with a button for each
            provider, such as <strong>Continue with Google</strong>
            (<code>brand</code> in <code>src/lib/brand.ts</code>), then its
            share page the first time. The share
            page lists your email addresses so you can pick one. After that,
            delegate remembers your choice (a Grant) and logs you straight in.
            Then the dialog’s Role section. VIP requires Level 1; Admin
            requires Level 3.
          </p>
          <p>
            <strong>Switch email</strong> in the dialog asks delegate again
            with <code>prompt=select</code>, so the share page always appears.
            Use it to pick a different email address, add one, or switch to
            another account or provider.
          </p>
          <div class="btn-row">
            <a class="btn btn-primary" href={loginUrl} data-open-login>Login</a>
          </div>
        </article>

        <article class="card option">
          <h2>2. Without the widget (fallback)</h2>
          <p class="tag">Identity Token · JWT · no shared secret</p>
          <p>
            The same sign-in for browsers without JavaScript or popups:
            core's <code>/api/auth/start</code>, a plain link. Core sends
            Delegate this site's <code>config.signIn</code>
            (<code>min_level=1</code>, <code>display_name</code> and
            <code>email</code>, <code>brand_google=skip</code> so a signed-out
            visitor goes straight to the provider when Delegate offers only
            one), and
            <code>/api/auth/callback</code> sets the same
            <code>e9_session</code> cookie. <strong>Log in (popup)</strong>
            calls <code>requestIdentity()</code> and
            <code>id.core.login()</code> from <code>@engine9/id</code>
            directly. <strong>Change your Delegate information</strong> is
            <code>changeSignInUrl()</code> (<code>prompt=select</code>). A
            person without a role picks one on <code>/choose-role</code>.
          </p>
          <div class="btn-row three">
            <a class="btn btn-ghost option-ghost" id="identity-redirect" href={loginUrl}>Log in</a>
            <button
              class="btn btn-ghost option-ghost"
              type="button"
              id="identity-id-popup"
              data-fields={LOGIN_FIELDS.join(",")}
            >
              Log in (popup)
            </button>
            <a class="btn btn-ghost option-ghost" href={changeUrl}>
              Change your Delegate information
            </a>
          </div>
        </article>

        <article class="card option" id="level-2">
          <h2>3. Level 2: an emailed code</h2>
          <p class="tag">login_level=2 · min_level=2 · no provider account needed</p>
          <p>
            For people without a Google, Microsoft, or Facebook account, or
            who would rather not use one. The same popup sign-in as option 2,
            asking Delegate for <code>minLevel: 2</code> and
            <code>loginLevel: 2</code>: Delegate's sign-in screen gets an
            email field, mails a 6-digit code, and the code proves the person
            receives mail at that address. That is Level 2 (Contact
            Confirmed). Core then sets the same <code>e9_session</code> cookie.
          </p>
          <p class="outcome">
            <strong>You’ll see:</strong> Delegate's sign-in with an email field,
            then a code in your inbox. Then
            <a href="/level-2">the Level 2 page</a>, which the middleware opens
            only for a sign-in at Level 2 or above. A Level 2 sign-in does not
            open <code>/admin</code>: Admin needs Level 3. If you are already
            signed in to Delegate with Google, Microsoft, or Facebook, it
            returns that sign-in (Level 3)
            instead; log out first to see the email screen.
          </p>
          <p>
            This needs JavaScript: core's no-JavaScript
            <code>/api/auth/start</code> always asks for this site's one
            <code>config.signIn</code> (Level 1).
          </p>
          <div class="btn-row">
            <button
              class="btn btn-primary"
              type="button"
              id="identity-level-2"
              data-fields={LOGIN_FIELDS.join(",")}
            >
              Sign in with an emailed code (Level 2)
            </button>
            <a class="btn btn-ghost option-ghost" href="/level-2">Open the Level 2 page</a>
          </div>
        </article>

        <article class="card option">
          <h2>4. Who am I (debug, no login)</h2>
          <p class="tag">Pre-login identity</p>
          <p>
            Asks Delegate who this browser already is — <code>unid</code> and
            whether they are logged in on Delegate — <em>without</em> creating a
            festival session (<code>GET /whoami</code>).
          </p>
          <p class="outcome">
            <strong>Cross-site limit:</strong> Delegate cookies are
            <code>SameSite=Lax</code>, so a credentialed <code>fetch</code> or
            <code>&lt;script src&gt;</code> from this demo origin will
            <em>not</em> see who you are on Delegate (you get a throwaway
            anonymous UNID). A short top-level <strong>popup</strong> to
            <code>/whoami/bridge</code> does send cookies; it
            <code>postMessage</code>s the real identity back (allowlisted origin
            only — not XSS).
          </p>
          <div class="btn-row">
            <button
              class="btn btn-ghost option-ghost"
              type="button"
              id="whoami-fetch"
              data-url={whoamiUrl}
            >
              Try credentialed fetch
            </button>
            <button
              class="btn btn-primary"
              type="button"
              id="whoami-probe"
              data-url={whoamiBridgeUrl.toString()}
            >
              Look up via popup bridge
            </button>
            <button
              class="btn btn-ghost option-ghost"
              type="button"
              id="identity-probe"
              data-url={identityBridgeUrl.toString()}
            >
              Anonymous token (Level 0)
            </button>
          </div>
          <pre id="identity-result" class="identity-result" hidden></pre>
        </article>

        <article class="card option">
          <h2>5. Delegate’s own sign-in (debug)</h2>
          <p class="tag">Delegate only · no festival session</p>
          <p>
            <strong>Sign in to Delegate only</strong> opens Delegate’s own
            <code>/login</code> with no <code>return_to</code> back to this
            site. It signs you in to Delegate (UNID ↔ your provider account) but does
            <em>not</em> log you in here.
          </p>
          <p class="outcome">
            <strong>You’ll see:</strong> Delegate’s sign-in in a new tab. This
            demo’s header stays logged out until you use its Login button.
            Option 4’s popup bridge will then report <code>loggedIn: true</code>.
          </p>
          <a class="btn btn-ghost option-ghost" href={directDelegateLoginUrl} target="_blank" rel="noreferrer">
            Sign in to Delegate only
          </a>
        </article>
      </div>

    {session && (
      <p class="muted session-note">
        You're currently logged in as <strong>{primaryRole(session).toUpperCase()}</strong>
        (person_id {session.personId}{session.email ? `, ${session.email}` : ""}).
        <a href={changeUrl}>Change your Delegate information</a> signs you in
        with another address or account; what you can see follows the address.
      </p>
    )}
  </div>
</Layout>

<script is:inline define:vars={{ delegateBase }}>
  const TAG = "[festival login]";
  const identityResult = document.getElementById("identity-result");

  const failed = new URLSearchParams(window.location.search);
  if (failed.has("login_error")) {
    console.error(TAG, "The last login failed.", { login_error: failed.get("login_error") });
  }

  document.getElementById("identity-redirect")?.addEventListener("click", (e) => {
    const link = e.currentTarget;
    console.info(TAG, "Redirecting to core /api/auth/start, then Delegate /identity/authorize.", {
      url: link instanceof HTMLAnchorElement ? link.href : null,
    });
  });

  function showIdentity(label, data) {
    if (!identityResult) return;
    identityResult.hidden = false;
    identityResult.textContent =
      typeof label === "string"
        ? label + "\n" + JSON.stringify(data, null, 2)
        : JSON.stringify(data, null, 2);
  }

  document.getElementById("whoami-fetch")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    const url = btn instanceof HTMLElement ? btn.dataset.url : null;
    if (!url) return;
    console.info(TAG, "GET " + url + " (credentialed fetch)");
    let res;
    try {
      res = await fetch(url, { credentials: "include" });
    } catch (err) {
      console.error(TAG, "GET " + url + " got no response (blocked by CORS, an extension, or the network).", err);
      showIdentity("// fetch failed before a response", { url, error: String(err) });
      return;
    }
    const info = {
      url,
      status: res.status,
      contentType: res.headers.get("content-type"),
      cfRay: res.headers.get("cf-ray"),
    };
    const text = await res.text();
    try {
      const data = JSON.parse(text);
      console.info(TAG, "whoami response", info, data);
      showIdentity(
        "// credentialed fetch (SameSite=Lax → cookies usually NOT sent cross-site)",
        data,
      );
    } catch {
      console.error(TAG, "whoami did not return JSON (a Cloudflare bot check returns HTML).", info);
      showIdentity("// whoami did not return JSON", { ...info, bodyStart: text.slice(0, 200) });
    }
  });

  document.getElementById("whoami-probe")?.addEventListener("click", (e) => {
    const btn = e.currentTarget;
    const url = btn instanceof HTMLElement ? btn.dataset.url : null;
    if (!url) return;
    console.info(TAG, "Opening the whoami bridge popup.", { url });
    const popup = window.open(url, "delegate-whoami", "popup=yes,width=420,height=320");
    if (!popup) {
      console.warn(TAG, "The browser blocked the whoami popup.");
      window.alert("Popup blocked — allow popups for this site to use the whoami bridge.");
    }
  });

  window.addEventListener("message", (event) => {
    if (event.origin !== new URL(delegateBase).origin) {
      if (typeof event.data?.type === "string" && event.data.type.startsWith("delegate-")) {
        console.warn(TAG, "Ignored a " + event.data.type + " message from " + event.origin + "; expected " + new URL(delegateBase).origin + ".");
      }
      return;
    }
    if (typeof event.data?.type === "string") {
      console.info(TAG, "Message from Delegate", {
        type: event.data.type,
        error: event.data.error,
        token: typeof event.data.token === "string" ? event.data.token.length + " chars" : undefined,
      });
    }
    if (event.data?.type === "delegate-identity") {
      const { type: _t, ...payload } = event.data;
      showIdentity("// identity bridge (JWT or error)", payload);
      return;
    }
    if (!event.data || event.data.type !== "delegate-whoami") return;
    const { type: _type, ...identity } = event.data;
    showIdentity("// popup bridge (top-level → cookies sent)", identity);
  });

</script>

<script>
  import { createEngine9Id } from "@engine9/id";
  import { POPUP_SIGN_IN_BRAND } from "../lib/brand";

  const wrap = document.querySelector(".login-wrap");
  const delegateUrl =
    wrap instanceof HTMLElement
      ? wrap.dataset.delegateUrl || "https://delegate.network"
      : "https://delegate.network";
  const core = wrap instanceof HTMLElement ? JSON.parse(wrap.dataset.core || "null") : null;
  const TAG = "[festival login]";
  // The recommended client: core issues the nonce and sets the e9_session cookie.
  const id = createEngine9Id({ delegateUrl, storage: "session", debug: true, brand: POPUP_SIGN_IN_BRAND, core });
  // Debugging only: a Level 0 token, no sign-in with core.
  const probe = createEngine9Id({ delegateUrl, storage: "memory", debug: true, brand: POPUP_SIGN_IN_BRAND });
  const identityResult = document.getElementById("identity-result");

  function show(label: string, data: unknown) {
    if (!identityResult) return;
    identityResult.hidden = false;
    identityResult.textContent = `${label}\n${JSON.stringify(data, null, 2)}`;
  }

  function errorReport(err: unknown) {
    if (err && typeof err === "object") {
      const e = err as { name?: string; code?: string; message?: string; details?: unknown };
      return { name: e.name, code: e.code, message: e.message, details: e.details };
    }
    return { message: String(err) };
  }

  /** A popup answer for another request. "Log in again", never an error or "expired". */
  function isStateMismatch(err: unknown) {
    const e = err as { code?: string; details?: { step?: string } } | null;
    return e?.code === "state_mismatch" || (e?.code === "invalid_request" && e?.details?.step === "state");
  }

  function fail(label: string, err: unknown) {
    if (isStateMismatch(err)) {
      console.info(TAG, "That login answered an earlier attempt. Log in again.");
      show("// that login answered an earlier attempt", { next: "Log in again" });
      return;
    }
    const report = errorReport(err);
    console.error(TAG, label, report, err);
    show(`// ${label}`, report);
  }

  document.getElementById("identity-id-popup")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    const raw = btn instanceof HTMLElement ? btn.dataset.fields || "" : "";
    const fields = raw.split(",").map((name) => name.trim()).filter(Boolean);
    console.info(TAG, "Popup login: opening Delegate /identity/bridge.", { delegateUrl, fields });
    let identity;
    try {
      identity = await id.requestIdentity({
        minLevel: 1,
        mode: "popup",
        fields,
      });
    } catch (err) {
      fail("Popup login failed in @engine9/id (Delegate popup)", err);
      return;
    }
    if (!identity) {
      console.warn(TAG, "The browser blocked the popup; @engine9/id is sending this page to Delegate instead.");
      return;
    }
    console.info(TAG, "Popup login: Delegate returned a verified Identity Token.", {
      level: identity.level,
      exp: identity.exp,
    });
    // core checks the nonce it issued and the state, then sets e9_session.
    console.info(TAG, "Popup login: POST /api/auth/login with cookie: true.");
    try {
      await id.core!.login();
    } catch (err) {
      fail("Popup login: core could not finish the login", err);
      return;
    }
    window.location.assign("/signed-in");
  });

  document.getElementById("identity-level-2")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    const raw = btn instanceof HTMLElement ? btn.dataset.fields || "" : "";
    const fields = raw.split(",").map((name) => name.trim()).filter(Boolean);
    console.info(TAG, "Level 2 login: opening Delegate /identity/bridge with login_level=2.", { delegateUrl, fields });
    let identity;
    try {
      identity = await id.requestIdentity({
        minLevel: 2,
        loginLevel: 2,
        mode: "popup",
        fields,
      });
    } catch (err) {
      fail("Level 2 login failed in @engine9/id (Delegate popup)", err);
      return;
    }
    if (!identity) {
      console.warn(TAG, "The browser blocked the popup; @engine9/id is sending this page to Delegate instead.");
      return;
    }
    console.info(TAG, "Level 2 login: Delegate returned a verified Identity Token.", {
      level: identity.level,
      exp: identity.exp,
    });
    try {
      await id.core!.login();
    } catch (err) {
      fail("Level 2 login: core could not finish the login", err);
      return;
    }
    window.location.assign("/level-2");
  });

  document.getElementById("identity-probe")?.addEventListener("click", async () => {
    console.info(TAG, "Level 0 probe: opening Delegate /identity/bridge.");
    try {
      const identity = await probe.requestIdentity({ minLevel: 0, mode: "popup" });
      console.info(TAG, "Level 0 probe result", identity ?? { empty: true });
      show("// @engine9/id identity (Level 0)", identity ?? { empty: true });
    } catch (err) {
      fail("Level 0 probe failed in @engine9/id (Delegate popup)", err);
    }
  });
</script>

<style>
  .login-wrap { max-width: 44rem; margin: 0 auto; padding-top: 0.5rem; }
  .lede { color: var(--muted); margin: 0 0 1.5rem; }
  .options { display: grid; gap: 1rem; }
  .option h2 { margin: 0 0 0.35rem; font-size: 1.15rem; }
  .option .tag {
    display: inline-block;
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .option p { margin: 0 0 0.75rem; color: var(--muted); font-size: 0.95rem; }
  .option .outcome { color: var(--text); }
  .option .btn { margin-top: 0.35rem; text-align: center; width: 100%; box-sizing: border-box; }
  .btn-row {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }
  @media (min-width: 520px) {
    .btn-row { grid-template-columns: 1fr 1fr; }
    .option:first-child .btn-row, .btn-row.three { grid-template-columns: 1fr; }
  }
  @media (min-width: 720px) {
    .btn-row.three { grid-template-columns: 1fr 1fr 1fr; }
  }
  .btn-row .btn { margin-top: 0; }
  .option-ghost { border-color: var(--border); }
  .identity-result {
    margin: 0.9rem 0 0;
    padding: 0.75rem 0.9rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.8rem;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .notice {
    background: rgba(244, 114, 182, 0.12);
    border: 1px solid rgba(244, 114, 182, 0.4);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1rem;
  }
  .notice.error {
    background: rgba(248, 113, 113, 0.12);
    border-color: rgba(248, 113, 113, 0.4);
  }
  .notice.error.config, .notice.config {
    background: rgba(251, 191, 36, 0.12);
    border-color: rgba(251, 191, 36, 0.45);
  }
  .operator-detail {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted, #94a3b8);
  }
  .session-note { margin-top: 1.5rem; }
  .change-hint { display: block; margin-top: 0.5rem; }
  code { background: var(--surface-2); padding: 0.1rem 0.35rem; border-radius: 4px; }
</style>
