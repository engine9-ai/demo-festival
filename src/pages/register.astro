---
import Layout from "../layouts/Layout.astro";

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");
const personId = Astro.url.searchParams.get("person_id");
---

<Layout title="Register">
  <div class="register-wrap">
    <div class="card register-card">
      <h1>Register</h1>
      <p class="muted">
        Sign up with schema field names
        (<code>given_name</code>, <code>family_name</code>, <code>email</code>,
        <code>email_type</code>). This is a Level 1 public form:
        <code>POST /api/people</code> uses an <code>e9publickey_</code>
        (scope <code>public</code>), not the
        private demo key.
      </p>

      {ok && (
        <p class="notice ok">
          You're registered{personId && <> — your <code>person_id</code> is <strong>{personId}</strong></>}.
        </p>
      )}

      {error && (
        <p class="notice err">
          Registration failed{error === "given_name" ? ": enter your given name" : error === "email" ? ": enter a valid email" : error === "email_type" ? ": choose a valid email_type" : `: ${error}`}.
        </p>
      )}

      <form method="post" action="/auth/register">
        <div class="field">
          <label for="given_name">Given name</label>
          <input id="given_name" name="given_name" type="text" required autocomplete="given-name" placeholder="Alex" />
        </div>
        <div class="field">
          <label for="family_name">Family name</label>
          <input id="family_name" name="family_name" type="text" autocomplete="family-name" placeholder="Rivera" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="alex@example.com" />
        </div>
        <div class="field">
          <label for="email_type">Email type</label>
          <select id="email_type" name="email_type" required>
            <option value="Personal" selected>Personal</option>
            <option value="Work">Work</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <button class="btn btn-primary" type="submit">Register</button>
      </form>

      <p class="muted fine">
        Already have VIP access? <a href="/login" data-open-login>Log in</a>.
      </p>
    </div>
  </div>
</Layout>

<style>
  .register-wrap { display: flex; justify-content: center; padding-top: 2rem; }
  .register-card { max-width: 28rem; width: 100%; }
  .field { margin-bottom: 1rem; }
  .field label { display: block; font-weight: 600; margin-bottom: 0.35rem; }
  .field input, .field select {
    width: 100%;
    padding: 0.55rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--line, #ccc);
    font: inherit;
  }
  .notice { padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem; }
  .notice.ok { background: color-mix(in srgb, var(--ok, #3d9a6a) 18%, transparent); }
  .notice.err { background: color-mix(in srgb, var(--danger, #c45c5c) 18%, transparent); }
  .fine { margin-top: 1rem; font-size: 0.9rem; }
  code { background: var(--surface-2, #eee); padding: 0.1rem 0.35rem; border-radius: 4px; }
</style>
